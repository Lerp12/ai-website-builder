LLM_API_KEY=sk-or-v1-your-key-here

# OpenAI-compatible base URL. OpenRouter by default.
# Change to point at OpenAI direct, Ollama, LM Studio, etc.
LLM_BASE_URL=https://openrouter.ai/api/v1

# Model used for full page generation and section edits.
# OpenRouter routing examples:
#   anthropic/claude-3.5-sonnet
#   openai/gpt-4o-mini
#   google/gemini-flash-1.5
LLM_MODEL=anthropic/claude-3.5-sonnet

# Optional: OpenRouter ranks providers; this is useful when set.
# HTTP_REFERER=http://localhost:5173
